#!/usr/bin/env python3
"""linkctl - verslechter of verbreek ISP-links in de underlay-router (tc netem).

  linkctl show
  linkctl set <iface> [--delay MS] [--jitter MS] [--loss PCT] [--rate MBIT]
  linkctl clear [<iface>|all]
  linkctl down <iface> | up <iface>

De impairment geldt voor het verkeer ISP -> site (egress op de toegangslink naar de FortiGate);
een ping vanaf de site ziet dus de vertraging/het verlies één keer in de retourrichting."""
import argparse
import json
import subprocess
import sys


def sh(*cmd, check=True):
    r = subprocess.run(cmd, capture_output=True, text=True)
    if check and r.returncode:
        sys.exit(f"{' '.join(cmd)}: {r.stderr.strip()}")
    return r.stdout


def ifaces():
    return [x["ifname"] for x in json.loads(sh("ip", "-j", "link")) if x["ifname"].startswith("eth") and x["ifname"] not in ("eth0", "eth1")]


def show():
    out = {}
    for i in ifaces():
        q = sh("tc", "qdisc", "show", "dev", i, check=False)
        link = json.loads(sh("ip", "-j", "link", "show", i))[0]
        out[i] = {"up": "UP" in link.get("flags", []), "netem": next((l.strip() for l in q.splitlines() if "netem" in l), None)}
    print(json.dumps(out))


def set_link(a):
    args = ["tc", "qdisc", "replace", "dev", a.iface, "root", "netem"]
    if a.delay is not None:
        args += ["delay", f"{a.delay}ms"] + ([f"{a.jitter}ms", "distribution", "normal"] if a.jitter else [])
    if a.loss is not None:
        args += ["loss", f"{a.loss}%"]
    if a.rate is not None:
        args += ["rate", f"{a.rate}mbit"]
    sh(*args)
    print(f"{a.iface}: {' '.join(args[7:]) or 'geen impairment'}")


def clear(target):
    for i in (ifaces() if target in (None, "all") else [target]):
        sh("tc", "qdisc", "del", "dev", i, "root", check=False)
        sh("ip", "link", "set", i, "up")
    print("opgeschoond")


def main():
    p = argparse.ArgumentParser()
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("show")
    s = sub.add_parser("set")
    s.add_argument("iface"); s.add_argument("--delay", type=float); s.add_argument("--jitter", type=float)
    s.add_argument("--loss", type=float); s.add_argument("--rate", type=float)
    c = sub.add_parser("clear"); c.add_argument("iface", nargs="?")
    for n in ("down", "up"):
        sub.add_parser(n).add_argument("iface")
    a = p.parse_args()
    if a.cmd == "show": show()
    elif a.cmd == "set": set_link(a)
    elif a.cmd == "clear": clear(a.iface)
    else:
        sh("ip", "link", "set", a.iface, a.cmd)
        print(f"{a.iface} {a.cmd}")


if __name__ == "__main__":
    main()
